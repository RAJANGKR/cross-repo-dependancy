# Copy to .env.local to override. No secrets belong in the frontend:
# GitHub and Gemini keys are configured on the backend only.

# Base URL of the FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000

# false (default): "Analyze repositories" calls the backend scan API.
# true: it plays the bundled demo scan instead, labeled "Demo data".
VITE_USE_MOCK=false
