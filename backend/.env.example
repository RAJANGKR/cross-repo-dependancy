# DriftLock Backend Environment Variables
# Copy this file to .env and fill in what you need. Never commit .env.
APP_NAME=DriftLock Backend
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# CORS settings - add frontend URLs (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173

# Optional. Raises the GitHub API limit from 60 to 5,000 requests per hour.
# A token with no scopes is enough for public repositories. Give it no access to private
# repositories: private repositories are read only with the signed-in user's GitHub App grant.
GITHUB_TOKEN=

# Optional. Without it, explanations are generated from rules.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# SQLite cache for public upstream data (never pasted content).
CACHE_ENABLED=true
CACHE_PATH=driftlock_cache.db

# Sign in with GitHub. Optional: leave both empty to run without sign-in.
# With a GitHub App (recommended, needed for private repositories) these are the App's
# Client ID and a client secret generated on its settings page. A plain OAuth app also
# works, for sign-in only. Callback URL in either case:
#   {backend URL}/api/v1/auth/github/callback   e.g. http://localhost:8000/api/v1/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# GitHub App: lets signed-in users pick repositories and scan private ones.
# Optional. All four are needed. Setup guide: docs/GITHUB_APP_SETUP.md
# App ID, shown on the App's settings page.
GITHUB_APP_ID=
# The App's URL name, as in https://github.com/apps/<slug>
GITHUB_APP_SLUG=
# The App's private key. Prefer a path to the downloaded .pem file, kept outside the repository:
GITHUB_APP_PRIVATE_KEY_PATH=
# or the PEM text itself on one line, with line breaks written as \n:
GITHUB_APP_PRIVATE_KEY=
# Any long random string. Keeps people signed in across backend restarts.
SESSION_SECRET=
# Sign-in is optional by default. true makes it mandatory before a scan can be started.
AUTH_REQUIRED=false
